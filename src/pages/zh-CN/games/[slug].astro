---
import GameDetailPage from "@/components/GameDetailPage.astro";
import { getLatestRelease, type GameRelease } from "@/data/downloads";
import { games, type GameContent } from "@/data/games";

type Props = {
  game: GameContent;
  release?: GameRelease;
};

export function getStaticPaths() {
  return games["zh-CN"].map((game) => ({
    params: { slug: game.slug },
    props: { game, release: getLatestRelease(game.slug) },
  }));
}

const { game, release } = Astro.props;
---

<GameDetailPage locale="zh-CN" game={game} release={release} />
