---
import CTAButton from "@/components/CTAButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLatestRelease } from "@/data/downloads";
import { getGame } from "@/data/games";
import { getTiSimulatorWechatCover } from "@/data/media";
import { getFeedbackLink } from "@/data/social";
import { t } from "@/i18n/utils";

const locale = "zh-CN";
const game = getGame(locale, "ti-simulator");
const release = getLatestRelease("ti-simulator");
if (!game || !release) throw new Error("Missing WeChat page data.");
const wechatCover = getTiSimulatorWechatCover(locale);
const feedbackLink = getFeedbackLink(locale);
---

<BaseLayout
  locale={locale}
  title={t(locale, "wechat.title")}
  description={t(locale, "wechat.description")}
  ogImage={wechatCover}
  accentRgb="20 112 245"
  alternatePaths={{ "zh-CN": "/zh-CN/wechat", en: "/en/games/ti-simulator" }}
>
  <section class="container-page pt-14 pb-10 md:pt-18 md:pb-12">
    <p class="eyebrow">{t(locale, "wechat.eyebrow")}</p>
    <h1 class="balance mt-4 text-4xl font-semibold leading-tight sm:text-5xl">{t(locale, "wechat.heading")}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{game.summary}</p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <CTAButton href="/zh-CN/download#ti-simulator" label={t(locale, "wechat.downloadCta")} />
      <CTAButton href="/zh-CN/games/ti-simulator" label={t(locale, "wechat.detailCta")} variant="secondary" />
      <CTAButton href="/zh-CN" label={t(locale, "wechat.homeCta")} variant="secondary" />
    </div>
  </section>

  <section class="container-page pb-10">
    <figure class="m-0 mx-auto max-w-xl overflow-hidden rounded-[28px] border border-line bg-panel shadow-soft">
      <img src={wechatCover} alt={t(locale, "media.tiSimulatorPreviewAlt")} loading="eager" class="max-h-[720px] w-full bg-paper object-contain" />
      <figcaption class="border-t border-line bg-white/86 px-5 py-3 text-xs text-muted">
        {t(locale, "media.entertainmentDisclaimer")}
      </figcaption>
    </figure>
  </section>

  <section class="container-page grid gap-5 pb-20 md:grid-cols-3">
    <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
      <h2 class="text-xl font-semibold">{t(locale, "wechat.versionTitle")}</h2>
      <p class="mt-3 text-sm leading-7 text-muted">
        {t(locale, "wechat.versionBody", { version: release.version, date: release.displayDate[locale] })}
      </p>
    </article>

    <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
      <h2 class="text-xl font-semibold">{t(locale, "wechat.groupTitle")}</h2>
      <p class="mt-3 text-sm leading-7 text-muted">{t(locale, "wechat.groupBody")}</p>
    </article>

    <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
      <h2 class="text-xl font-semibold">{t(locale, "wechat.guidanceTitle")}</h2>
      <p class="mt-3 text-sm leading-7 text-muted">
        {feedbackLink.available ? t(locale, "wechat.guidanceAvailable") : t(locale, "wechat.guidanceComingSoon")}
      </p>
      <div class="mt-4">
        <CTAButton href="/zh-CN/games/out-of-tokens" label="了解 Out of Tokens" variant="secondary" compact />
      </div>
    </article>
  </section>
</BaseLayout>
