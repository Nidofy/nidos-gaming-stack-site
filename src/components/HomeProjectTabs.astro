---
import CTAButton from "@/components/CTAButton.astro";
import FeatureGrid from "@/components/FeatureGrid.astro";
import { OUT_OF_TOKENS_PLAY_URL } from "@/data/games";
import { getPortfolioItems } from "@/data/portfolio";
import type { Locale } from "@/data/site";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  subtitle: string;
  metaItems?: string[];
}

const { locale, eyebrow, title, subtitle, metaItems = [] } = Astro.props;
const items = getPortfolioItems(locale);
const defaultSlug = items[0]?.slug ?? "out-of-tokens";
---

<div data-home-project-tabs>
  <section class="container-page pt-16 pb-12 text-center md:pt-24 md:pb-14">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="balance mx-auto mt-5 max-w-4xl text-4xl font-semibold leading-[1.12] tracking-tight sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    <p class="balance mx-auto mt-6 max-w-3xl text-lg leading-8 text-muted md:text-xl md:leading-9">{subtitle}</p>

    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
      <CTAButton href={OUT_OF_TOKENS_PLAY_URL} label={t(locale, "home.hero.primary")} external />
      <CTAButton href="#all-projects" label={t(locale, "home.hero.secondary")} variant="secondary" />
    </div>

    {
      metaItems.length > 0 && (
        <div class="mx-auto mt-7 flex max-w-3xl flex-wrap justify-center gap-2">
          {metaItems.map((item) => (
            <span class="rounded-full border border-line bg-white/80 px-3.5 py-1.5 text-sm font-medium text-muted shadow-sm">
              {item}
            </span>
          ))}
        </div>
      )
    }

    <div id="games" class="mt-10 scroll-mt-24">
      <div
        class="mx-auto inline-flex max-w-full flex-wrap items-center justify-center gap-1.5 rounded-full border border-line bg-white/88 p-1.5 shadow-soft"
        role="tablist"
        aria-label={t(locale, "home.tabs.aria")}
      >
        {
          items.map((project) => (
            <button
              type="button"
              class="home-project-tab rounded-full px-4 py-2.5 text-sm font-semibold text-muted transition hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/30 sm:px-5 sm:text-base"
              role="tab"
              aria-selected={project.slug === defaultSlug ? "true" : "false"}
              aria-controls={`home-project-panel-${project.slug}`}
              id={`home-project-tab-${project.slug}`}
              data-tab-target={project.slug}
              tabindex={project.slug === defaultSlug ? 0 : -1}
            >
              {project.tabLabel}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-8 text-left md:mt-10">
      {
        items.map((item) => (
          <div
            id={`home-project-panel-${item.slug}`}
            role="tabpanel"
            aria-labelledby={`home-project-tab-${item.slug}`}
            data-tab-panel={item.slug}
            hidden={item.slug !== defaultSlug}
            style={`--color-accent: ${item.accentRgb};`}
          >
            <article
              id={`project-${item.slug}`}
              class="grid scroll-mt-28 gap-8 rounded-[28px] border border-line bg-panel p-6 shadow-soft md:grid-cols-[1.16fr_0.84fr] md:items-center md:p-8 lg:grid-cols-[1.22fr_0.78fr] lg:p-10"
            >
              <figure class="m-0 overflow-hidden rounded-[22px] border border-line bg-paper">
                <a href={item.detailHref} class="block">
                  <img
                    src={item.heroMedia.src}
                    alt={item.heroMedia.alt}
                    width={item.heroMedia.width}
                    height={item.heroMedia.height}
                    loading={item.slug === defaultSlug ? "eager" : "lazy"}
                    fetchpriority={item.slug === defaultSlug ? "high" : "auto"}
                    decoding="async"
                    class="aspect-[16/10] w-full bg-paper object-cover"
                  />
                </a>
                {item.heroMedia.caption && (
                  <figcaption class="border-t border-line bg-white/80 px-4 py-2.5 text-xs leading-5 text-muted">
                    {item.heroMedia.caption}
                  </figcaption>
                )}
              </figure>

              <div class="flex flex-col justify-center">
                <p class="eyebrow">{item.eyebrow}</p>
                <p class="mt-2 text-xs font-medium text-muted">
                  {item.statusLabel}
                  {item.versionLabel ? ` · ${item.versionLabel}` : ""}
                </p>
                <h2 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{item.title}</h2>
                <p class="mt-4 text-base leading-8 text-muted sm:text-lg">{item.summary}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="rounded-full border border-line bg-paper/70 px-3 py-1 text-xs font-medium text-muted sm:text-sm">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="mt-7 flex flex-wrap gap-3">
                  <CTAButton
                    href={item.primaryCta.href}
                    label={item.primaryCta.label}
                    external={item.primaryCta.external}
                    compact
                  />
                  <CTAButton
                    href={item.secondaryCta.href}
                    label={item.secondaryCta.label}
                    external={item.secondaryCta.external}
                    variant="secondary"
                    compact
                  />
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>
  </section>

  {
    items.map((item) => (
      <section
        class="border-y border-line/70 bg-white/74 py-16 md:py-24"
        data-home-project-detail={item.slug}
        hidden={item.slug !== defaultSlug}
        style={`--color-accent: ${item.accentRgb};`}
      >
        <div class="container-page">
          <div class="max-w-3xl">
            <p class="eyebrow">{t(locale, "home.preview.featuresEyebrow")}</p>
            <h2 class="balance mt-3 text-3xl font-semibold sm:text-4xl">{item.featuresTitle}</h2>
            <p class="mt-4 text-base leading-8 text-muted sm:text-lg">{item.description}</p>
          </div>

          <div class="mt-10">
            <FeatureGrid features={item.features} />
          </div>

          {item.gallery && item.gallery.images.length > 0 && (
            <div class="mt-14">
              <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="eyebrow">{item.gallery.eyebrow || t(locale, "home.preview.galleryEyebrow")}</p>
                  <h3 class="mt-2 text-2xl font-semibold sm:text-3xl">{item.gallery.title}</h3>
                </div>
                <p class="text-xs text-muted">{t(locale, "home.preview.openFullImage")}</p>
              </div>
              <div
                class:list={[
                  "grid gap-5",
                  item.gallery.images.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2",
                ]}
              >
                {item.gallery.images.slice(0, 4).map((image) => (
                  <figure class="m-0 flex flex-col justify-between overflow-hidden rounded-[24px] border border-line bg-panel shadow-sm">
                    <a
                      href={image.src}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={t(locale, "game.openImageAria", { alt: image.alt })}
                      class="block bg-paper p-2"
                    >
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full rounded-2xl bg-paper object-contain"
                      />
                    </a>
                    <figcaption class="border-t border-line px-5 py-3.5 text-sm leading-6 text-muted">
                      {image.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))
  }
</div>

<script>
  const roots = document.querySelectorAll("[data-home-project-tabs]");

  roots.forEach((root) => {
    const tabs = Array.from(root.querySelectorAll("[data-tab-target]")).filter(
      (node): node is HTMLElement => node instanceof HTMLElement
    );
    const panels = Array.from(root.querySelectorAll("[data-tab-panel]")).filter(
      (node): node is HTMLElement => node instanceof HTMLElement
    );
    const detailPanels = Array.from(root.querySelectorAll("[data-home-project-detail]")).filter(
      (node): node is HTMLElement => node instanceof HTMLElement
    );

    const activate = (slug: string) => {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute("data-tab-target") === slug;
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-tab-panel") !== slug;
      });

      detailPanels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-home-project-detail") !== slug;
      });
    };

    const activateHash = () => {
      const rawHash = window.location.hash;
      if (!rawHash) return;
      if (rawHash === "#games") {
        root.querySelector("#games")?.scrollIntoView({ block: "start" });
        return;
      }
      const slug = rawHash.replace(/^#project-/, "");
      if (!tabs.some((tab) => tab.dataset.tabTarget === slug)) return;
      activate(slug);
      root.querySelector("#games")?.scrollIntoView({ block: "start" });
    };

    window.addEventListener("hashchange", activateHash);
    activateHash();

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const slug = tab.getAttribute("data-tab-target");
        if (slug) {
          activate(slug);
          history.replaceState(null, "", `#project-${slug}`);
        }
      });

      tab.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (index + offset + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        if (!(nextTab instanceof HTMLElement)) return;
        nextTab.focus();
        const slug = nextTab.getAttribute("data-tab-target");
        if (slug) {
          activate(slug);
          history.replaceState(null, "", `#project-${slug}`);
        }
      });
    });
  });
</script>

<style>
  .home-project-tab[aria-selected="true"] {
    background: rgb(var(--color-ink));
    color: white;
    box-shadow: 0 12px 30px rgb(15 23 42 / 0.16);
  }
</style>
