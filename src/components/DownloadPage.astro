---
import DownloadCard from "@/components/DownloadCard.astro";
import CTAButton from "@/components/CTAButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLatestRelease } from "@/data/downloads";
import { OUT_OF_TOKENS_PLAY_URL, OUT_OF_TOKENS_REPO_URL, getGame } from "@/data/games";
import { getHomepageOgImage } from "@/data/media";
import { pluginEntries } from "@/data/plugins";
import { getFeedbackLink } from "@/data/social";
import type { Locale } from "@/data/site";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ootGame = getGame(locale, "out-of-tokens");
const rpgGame = getGame(locale, "untitled-action-rpg");
const tiGame = getGame(locale, "ti-simulator");
const tiRelease = getLatestRelease("ti-simulator");
const aiVillage = pluginEntries.find((entry) => entry.slug === "ai-village");
if (!ootGame || !rpgGame || !tiGame || !tiRelease) throw new Error("Missing download page data.");
const feedbackLink = getFeedbackLink(locale);
const ogImage = getHomepageOgImage(locale);
---

<BaseLayout locale={locale} title={t(locale, "download.title")} description={t(locale, "download.description")} ogImage={ogImage}>
  <section class="container-page pt-16 pb-10 md:pt-20 md:pb-12">
    <p class="eyebrow">{t(locale, "download.eyebrow")}</p>
    <h1 class="balance mt-4 max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
      {t(locale, "download.heading")}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{t(locale, "download.intro")}</p>
  </section>

  <section id="out-of-tokens" class="container-page pb-14 scroll-mt-24" style="--color-accent: 61 107 82;">
    <article class="grid gap-8 rounded-[28px] border border-line bg-panel p-6 shadow-soft md:grid-cols-[1.12fr_0.88fr] md:items-center md:p-10">
      <div>
        <p class="eyebrow">{t(locale, "download.webEyebrow")}</p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{t(locale, "download.webTitle")}</h2>
        <p class="mt-4 leading-8 text-muted">{t(locale, "download.webBody")}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {ootGame.platforms.map((platform) => (
            <span class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-medium text-muted sm:text-sm">
              {platform}
            </span>
          ))}
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <CTAButton href={OUT_OF_TOKENS_PLAY_URL} label={t(locale, "download.webPlayCta")} external />
          <CTAButton href={`/${locale}/games/out-of-tokens`} label={t(locale, "download.webDetailCta")} variant="secondary" />
          <CTAButton href={OUT_OF_TOKENS_REPO_URL} label={t(locale, "download.webSourceCta")} variant="secondary" external />
        </div>
      </div>

      <figure class="m-0 overflow-hidden rounded-[22px] border border-line bg-paper">
        <img
          src="/media/out-of-tokens/studio-workshop.webp"
          alt={ootGame.title}
          width="1600"
          height="900"
          loading="eager"
          class="aspect-[16/10] w-full object-cover"
        />
      </figure>
    </article>
  </section>

  <section class="container-page pb-16">
    <p class="eyebrow">{t(locale, "download.otherEyebrow")}</p>
    <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">{t(locale, "download.otherTitle")}</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2">
      {
        aiVillage && (
          <article class="flex flex-col justify-between rounded-[24px] border border-line bg-panel p-6 shadow-sm" style="--color-accent: 124 90 56;">
            <div>
              <div class="flex items-center justify-between gap-2">
                <p class="eyebrow">{aiVillage.copy[locale].name}</p>
                <span class="rounded-full border border-line bg-paper px-2.5 py-0.5 text-xs font-medium text-muted">
                  {aiVillage.release.version}
                </span>
              </div>
              <h3 class="mt-3 text-2xl font-semibold">{aiVillage.copy[locale].status}</h3>
              <p class="mt-3 leading-7 text-muted">{aiVillage.copy[locale].installNote}</p>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <CTAButton href={`/${locale}/plugins/${aiVillage.slug}#installation`} label={aiVillage.copy[locale].install} variant="secondary" compact />
              <CTAButton href={aiVillage.repository} label={aiVillage.copy[locale].source} variant="secondary" compact external />
            </div>
          </article>
        )
      }

      <article class="flex flex-col justify-between rounded-[24px] border border-line bg-panel p-6 shadow-sm" style="--color-accent: 183 47 69;">
        <div>
          <div class="flex items-center justify-between gap-2">
            <p class="eyebrow">{rpgGame.shortTitle}</p>
            <span class="rounded-full border border-line bg-paper px-2.5 py-0.5 text-xs font-medium text-muted">
              {rpgGame.statusLabel}
            </span>
          </div>
          <h3 class="mt-3 text-2xl font-semibold">{rpgGame.title}</h3>
          <p class="mt-3 leading-7 text-muted">{t(locale, "game.noReleaseData")} {rpgGame.summary}</p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <CTAButton href={`/${locale}/games/${rpgGame.slug}`} label={t(locale, "game.detailsCta")} variant="secondary" compact />
        </div>
      </article>
    </div>
  </section>

  <section id="ti-simulator" class="border-t border-line/70 bg-white/74 py-16 md:py-24 scroll-mt-20" style="--color-accent: 20 112 245;">
    <div class="container-page">
      <p class="eyebrow">{t(locale, "download.tiEyebrow")}</p>
      <h2 class="balance mt-3 max-w-4xl text-3xl font-semibold sm:text-4xl">{t(locale, "download.tiHeading")}</h2>
      <p class="mt-4 max-w-3xl text-base leading-8 text-muted sm:text-lg">{tiRelease.summary[locale]}</p>
      <p class="mt-4 max-w-3xl rounded-2xl border border-dashed border-line bg-white/86 p-4 text-sm leading-6 text-muted">
        {t(locale, "download.notice")}
      </p>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
        <div class="grid gap-4">
          {tiRelease.files.map((file) => <DownloadCard file={file} release={tiRelease} locale={locale} />)}
        </div>

        <div class="grid gap-5">
          <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
            <h3 class="text-xl font-semibold">{t(locale, "download.changelog")}</h3>
            <ul class="mt-4 space-y-2.5 text-sm leading-7 text-muted">
              {tiRelease.changelog[locale].map((item) => <li>• {item}</li>)}
            </ul>
          </article>
          <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
            <h3 class="text-xl font-semibold">{t(locale, "download.knownIssues")}</h3>
            <ul class="mt-4 space-y-2.5 text-sm leading-7 text-muted">
              {tiRelease.knownIssues[locale].map((item) => <li>• {item}</li>)}
            </ul>
          </article>
        </div>
      </div>

      {
        feedbackLink.available && (
          <div id="feedback" class="mt-10 rounded-[24px] border border-line bg-panel p-6 shadow-sm">
            <p class="eyebrow">{t(locale, "feedback.eyebrow")}</p>
            <h3 class="mt-2 text-2xl font-semibold">{t(locale, "feedback.downloadTitle")}</h3>
            <p class="mt-3 max-w-2xl leading-7 text-muted">{t(locale, "feedback.availableBody")}</p>
            <div class="mt-5">
              <CTAButton href={feedbackLink.href} label={feedbackLink.label} variant="secondary" external />
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
