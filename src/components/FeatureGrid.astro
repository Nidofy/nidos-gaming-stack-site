---
import type { GameFeature } from "@/data/games";

interface Props {
  features: GameFeature[];
}

const { features } = Astro.props;
const gridCols = features.length === 4 ? "md:grid-cols-2" : "md:grid-cols-3";
---

<div class={`grid gap-5 ${gridCols}`}>
  {
    features.map((feature, index) => (
      <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm">
        <span class="text-xs font-bold tracking-widest text-accent" aria-hidden="true">
          0{index + 1}
        </span>
        <h3 class="mt-2.5 text-xl font-semibold leading-snug">{feature.title}</h3>
        <p class="mt-3 leading-7 text-muted">{feature.description}</p>
      </article>
    ))
  }
</div>
