---
import FeatureGrid from "@/components/FeatureGrid.astro";
import type { GameContent } from "@/data/games";
import type { GamePreviewMedia } from "@/data/media";

interface Props {
  game: GameContent;
  media: GamePreviewMedia;
}

const { game, media } = Astro.props;
const gallery = media.gallery;
---

<section class="bg-white/74 py-16 md:py-24" style={`--color-accent: ${game.accentRgb};`}>
  <div class="container-page">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="eyebrow">{gallery?.eyebrow ?? game.statusLabel}</p>
      <h2 class="balance mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{gallery?.title ?? game.hero.title}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-muted">{gallery?.description ?? game.description}</p>
    </div>

    <FeatureGrid features={game.features} />

    {
      gallery && (
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {gallery.images.map((image) => (
            <figure class="m-0 overflow-hidden rounded-[24px] border border-line bg-panel shadow-sm">
              <img src={image.src} alt={image.alt} loading="lazy" class="aspect-[3/2] w-full bg-paper object-cover" />
              <figcaption class="border-t border-line px-5 py-4 text-sm font-medium text-muted">{image.caption}</figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>
