---
import CTAButton from "@/components/CTAButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocalizedDevlogs } from "@/data/devlogs";
import type { Locale } from "@/data/site";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = getLocalizedDevlogs(locale);
const accentMap: Record<string, string> = {
  "out-of-tokens": "61 107 82",
  "ai-village": "124 90 56",
  "untitled-action-rpg": "183 47 69",
  "ti-simulator": "20 112 245",
};
---

<BaseLayout locale={locale} title={t(locale, "devlog.title")} description={t(locale, "devlog.description")}>
  <section class="container-page pt-16 pb-10 md:pt-20 md:pb-12">
    <p class="eyebrow">{t(locale, "devlog.eyebrow")}</p>
    <h1 class="balance mt-4 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-6xl">
      {t(locale, "devlog.heading")}
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{t(locale, "devlog.intro")}</p>
  </section>

  <section class="container-page space-y-6 pb-24">
    {
      entries.map((entry) => (
        <article
          id={entry.id}
          style={`--color-accent: ${accentMap[entry.projectSlug] ?? "61 107 82"};`}
          class="rounded-[28px] border border-line bg-panel p-6 shadow-sm md:p-8"
        >
          <div class="flex flex-wrap items-center gap-2.5 text-sm">
            <time datetime={entry.date} class="font-semibold text-ink">
              {entry.date}
            </time>
            <span class="text-muted">·</span>
            <span class="font-semibold text-accent">{entry.projectName}</span>
            <span class="rounded-full border border-line bg-paper px-2.5 py-0.5 text-xs font-medium text-muted">
              {entry.badge}
            </span>
          </div>

          <h2 class="mt-3 text-2xl font-semibold leading-snug sm:text-3xl">{entry.title}</h2>
          <p class="mt-4 max-w-3xl leading-8 text-muted">{entry.summary}</p>

          <ul class="mt-5 space-y-2 text-sm leading-7 text-muted">
            {entry.highlights.map((point) => (
              <li>• {point}</li>
            ))}
          </ul>

          <div class="mt-6">
            <CTAButton href={entry.projectHref} label={t(locale, "devlog.viewProject")} variant="secondary" compact />
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
