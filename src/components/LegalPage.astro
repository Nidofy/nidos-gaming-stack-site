---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/data/site";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
  kind: "privacy" | "terms";
  alternatePaths?: Partial<Record<Locale, string>>;
}

const { locale, kind, alternatePaths } = Astro.props;
const zhFirst = locale === "zh-CN";
---

<BaseLayout
  locale={locale}
  title={t(locale, `${kind}.title`)}
  description={t(locale, `${kind}.description`)}
  alternatePaths={alternatePaths}
>
  <section class="container-page section-space">
    <p class="eyebrow">{t(locale, `${kind}.eyebrow`)}</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{t(locale, `${kind}.heading`)}</h1>

    <div class="mt-8 grid max-w-4xl gap-6">
      {
        zhFirst ? (
          <>
            <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm md:p-8" lang="zh-CN">
              <h2 class="text-xl font-semibold text-ink">{t(locale, `${kind}.zhHeading`)}</h2>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.zhBody1`)}</p>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.zhBody2`)}</p>
            </article>
            <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm md:p-8" lang="en">
              <h2 class="text-xl font-semibold text-ink">{t(locale, `${kind}.enHeading`)}</h2>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.enBody1`)}</p>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.enBody2`)}</p>
            </article>
          </>
        ) : (
          <>
            <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm md:p-8" lang="en">
              <h2 class="text-xl font-semibold text-ink">{t(locale, `${kind}.enHeading`)}</h2>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.enBody1`)}</p>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.enBody2`)}</p>
            </article>
            <article class="rounded-[24px] border border-line bg-panel p-6 shadow-sm md:p-8" lang="zh-CN">
              <h2 class="text-xl font-semibold text-ink">{t(locale, `${kind}.zhHeading`)}</h2>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.zhBody1`)}</p>
              <p class="mt-4 leading-8 text-muted">{t(locale, `${kind}.zhBody2`)}</p>
            </article>
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
