---
import CTAButton from "@/components/CTAButton.astro";
import FeatureGrid from "@/components/FeatureGrid.astro";
import PortfolioNav from "@/components/PortfolioNav.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { GameRelease } from "@/data/downloads";
import type { GameContent } from "@/data/games";
import { getGamePreviewMedia } from "@/data/media";
import { site, type Locale } from "@/data/site";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
  game: GameContent;
  release?: GameRelease;
}

const { locale, game, release } = Astro.props;
const previewMedia = getGamePreviewMedia(game.slug, locale);
const pageUrl = `${site.baseUrl}/${locale}/games/${game.slug}`;
---

<BaseLayout
  locale={locale}
  title={game.seo.title}
  description={game.seo.description}
  ogImage={previewMedia.og}
  accentRgb={game.accentRgb}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: game.title,
    description: game.description,
    applicationCategory: "Game",
    operatingSystem: game.platforms.join(", "),
    url: pageUrl,
    image: new URL(previewMedia.og, site.baseUrl).toString(),
    author: { "@type": "Person", name: site.author },
  }}
>
  <article>
    <section class="container-page pt-14 pb-12 md:pt-20 md:pb-16">
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div>
          <p class="eyebrow">{game.hero.eyebrow}</p>
          <p class="mt-2.5 text-sm font-medium text-muted">
            {game.statusLabel}
            {game.versionLabel ? ` · ${game.versionLabel}` : ""}
          </p>
          <h1 class="balance mt-4 text-4xl font-semibold leading-[1.14] tracking-tight sm:text-5xl">
            {game.hero.title}
          </h1>
          <p class="mt-5 text-lg leading-8 text-muted">{game.hero.subtitle}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <CTAButton
              href={game.detailPrimaryCta.href}
              label={game.detailPrimaryCta.label}
              external={game.detailPrimaryCta.external}
            />
            <CTAButton
              href={game.detailSecondaryCta.href}
              label={game.detailSecondaryCta.label}
              external={game.detailSecondaryCta.external}
              variant="secondary"
            />
          </div>
        </div>

        <figure class="m-0 overflow-hidden rounded-[28px] border border-line bg-panel shadow-soft">
          <img
            src={previewMedia.hero}
            alt={previewMedia.alt}
            width={previewMedia.width}
            height={previewMedia.height}
            loading="eager"
            fetchpriority="high"
            class="w-full bg-paper object-contain"
          />
          {previewMedia.disclaimer && (
            <figcaption class="border-t border-line bg-white/86 px-5 py-3 text-xs leading-5 text-muted">
              {previewMedia.disclaimer}
            </figcaption>
          )}
        </figure>
      </div>

      {game.facts.length > 0 && (
        <dl class="mt-10 grid gap-6 border-t border-line pt-7 sm:grid-cols-3">
          {game.facts.map((fact) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{fact.label}</dt>
              <dd class="mt-1.5 text-sm font-medium leading-6 text-ink sm:text-base">{fact.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </section>

    <section class="container-page section-space">
      <div class="grid gap-8 md:grid-cols-[0.88fr_1.12fr] md:items-start">
        <div>
          <p class="eyebrow">{game.title}</p>
          <h2 class="balance mt-3 text-3xl font-semibold sm:text-4xl">{game.tagline}</h2>
        </div>
        <div class="text-base leading-8 text-muted sm:text-lg sm:leading-9">
          <p>{game.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {game.platforms.map((platform) => (
              <span class="rounded-full border border-line bg-white px-3.5 py-1 text-sm font-medium text-ink">
                {platform}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-line/70 bg-white/74 py-16 md:py-24">
      <div class="container-page">
        <div class="mb-10 max-w-3xl">
          <p class="eyebrow">{t(locale, "home.preview.featuresEyebrow")}</p>
          <h2 class="balance mt-3 text-3xl font-semibold sm:text-4xl">{game.summary}</h2>
        </div>
        <FeatureGrid features={game.features} />
      </div>
    </section>

    {previewMedia.gallery && (
      <section id="gallery" class="container-page section-space scroll-mt-20">
        <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="eyebrow">{previewMedia.gallery.eyebrow}</p>
            <h2 class="balance mt-3 text-3xl font-semibold sm:text-4xl">{previewMedia.gallery.title}</h2>
            <p class="mt-4 leading-8 text-muted">{previewMedia.gallery.description}</p>
          </div>
          <p class="text-xs text-muted">{t(locale, "home.preview.openFullImage")}</p>
        </div>

        <div
          class:list={[
            "grid gap-5",
            previewMedia.gallery.images.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2",
          ]}
        >
          {previewMedia.gallery.images.map((image) => (
            <figure class="m-0 flex flex-col justify-between overflow-hidden rounded-[24px] border border-line bg-panel shadow-soft">
              <a
                href={image.src}
                target="_blank"
                rel="noreferrer"
                aria-label={t(locale, "game.openImageAria", { alt: image.alt })}
                class="block bg-paper p-2"
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/10] w-full rounded-2xl bg-paper object-contain"
                />
              </a>
              <figcaption class="border-t border-line px-5 py-4 text-sm leading-6 text-muted">
                {image.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="container-page pb-16">
      <div class="grid gap-8 md:grid-cols-2">
        {game.sections.map((section) => (
          <article class="rounded-[24px] border border-line bg-panel p-7 shadow-sm">
            <h3 class="text-2xl font-semibold leading-snug">{section.title}</h3>
            <p class="mt-4 leading-8 text-muted">{section.description}</p>
          </article>
        ))}
      </div>
    </section>

    {game.faq.length > 0 && (
      <section class="container-page section-space max-w-4xl" aria-labelledby="game-faq-title">
        <p class="eyebrow">FAQ</p>
        <h2 id="game-faq-title" class="mt-3 mb-8 text-3xl font-semibold sm:text-4xl">
          {t(locale, "game.faqTitle")}
        </h2>
        <div class="faq-accordion">
          {game.faq.map((item) => (
            <details>
              <summary>{item.title}</summary>
              <p class="mt-3 leading-8 text-muted">{item.description}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="container-page pb-10">
      <div class="rounded-[28px] border border-line bg-panel p-7 shadow-soft md:p-10">
        <p class="eyebrow">{t(locale, "game.playtestEyebrow")}</p>
        <h2 class="mt-3 text-2xl font-semibold sm:text-3xl">
          {release ? t(locale, "game.currentBuild", { version: release.version }) : game.title}
        </h2>
        <p class="mt-4 max-w-3xl leading-8 text-muted">
          {release ? release.summary[locale] : game.summary}
        </p>

        {game.sourceLinks.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-accent">
            {game.sourceLinks.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                class="underline underline-offset-4 hover:text-ink"
              >
                {link.label}
              </a>
            ))}
          </div>
        )}

        <p class="mt-5 border-t border-line pt-5 text-sm leading-6 text-muted">{game.legalNotes}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <CTAButton
            href={game.detailPrimaryCta.href}
            label={game.detailPrimaryCta.label}
            external={game.detailPrimaryCta.external}
          />
          <CTAButton
            href={`/${locale}/devlog`}
            label={t(locale, "game.devlogCta")}
            variant="secondary"
          />
          <CTAButton
            href={`/${locale}/#games`}
            label={t(locale, "game.backToGamesCta")}
            variant="secondary"
          />
        </div>
      </div>
    </section>
  </article>

  <PortfolioNav locale={locale} activeSlug={game.slug} />
</BaseLayout>
