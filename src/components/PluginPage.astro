---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTAButton from "@/components/CTAButton.astro";
import FeatureGrid from "@/components/FeatureGrid.astro";
import PortfolioNav from "@/components/PortfolioNav.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { t } from "@/i18n/utils";
import type { PluginEntry } from "@/types/plugin";

interface Props {
  plugin: PluginEntry;
  locale: Locale;
}

const { plugin, locale } = Astro.props;
const c = plugin.copy[locale];
const hero = plugin.media.find((media) => media.role === "hero")!;
const featureMedia = plugin.media.find((media) => media.role === "feature");
const gallery = plugin.media.filter((media) => media.role === "gallery");
const packageFile = `nidofy-dsh-${plugin.slug}-${plugin.release.version}.tgz`;
---

<BaseLayout
  locale={locale}
  title={c.seo.title}
  description={c.seo.description}
  ogImage={hero.src}
  accentRgb="124 90 56"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: c.name,
    description: c.seo.description,
    applicationCategory: "EntertainmentApplication",
    operatingSystem: plugin.release.platform,
    softwareVersion: plugin.release.version,
    softwareRequirements: plugin.release.host,
    url: new URL(`/${locale}/plugins/${plugin.slug}`, site.baseUrl).toString(),
    image: new URL(hero.src, site.baseUrl).toString(),
    author: { "@type": "Person", name: site.author },
    isAccessibleForFree: true,
  }}
>
  <article>
    <section class="container-page pt-14 pb-12 md:pt-20 md:pb-16">
      <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <p class="mt-2.5 text-sm font-medium text-muted">
            {c.status} · {plugin.release.version}
          </p>
          <h1 class="balance mt-4 whitespace-pre-line text-4xl font-semibold leading-[1.16] tracking-tight sm:text-5xl">
            {c.headline}
          </h1>
          <p class="mt-5 text-lg leading-8 text-muted">{c.summary}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <CTAButton href="#installation" label={c.install} />
            <CTAButton href={plugin.repository} label={c.source} variant="secondary" external />
          </div>
        </div>

        <figure class="m-0 overflow-hidden rounded-[28px] border border-line bg-panel shadow-soft">
          <img
            src={hero.src}
            width={hero.width}
            height={hero.height}
            alt={hero.locales[locale].alt}
            fetchpriority="high"
            class="w-full bg-paper object-contain"
          />
          <figcaption class="border-t border-line bg-white/86 px-5 py-3 text-xs leading-5 text-muted">
            {hero.locales[locale].caption}
          </figcaption>
        </figure>
      </div>

      <dl class="mt-10 grid gap-6 border-t border-line pt-7 sm:grid-cols-3">
        {c.facts.map((fact) => (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">{fact.label}</dt>
            <dd class="mt-1.5 text-sm font-medium leading-6 text-ink sm:text-base">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="border-y border-line/70 bg-white/74 py-16 md:py-24">
      <div class="container-page">
        <div class="mb-10 max-w-3xl">
          <p class="eyebrow">{c.name}</p>
          <h2 class="balance mt-3 text-3xl font-semibold sm:text-4xl">{c.featuresTitle}</h2>
        </div>
        <FeatureGrid features={c.features} />
      </div>
    </section>

    <section class="container-page section-space">
      <div class="grid gap-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-center">
        {featureMedia && (
          <figure class="m-0 overflow-hidden rounded-[28px] border border-line bg-panel shadow-soft">
            <img
              src={featureMedia.src}
              width={featureMedia.width}
              height={featureMedia.height}
              alt={featureMedia.locales[locale].alt}
              loading="lazy"
              decoding="async"
              class="w-full bg-paper object-contain"
            />
            <figcaption class="border-t border-line bg-white/86 px-5 py-3 text-xs leading-5 text-muted">
              {featureMedia.locales[locale].caption}
            </figcaption>
          </figure>
        )}
        <div>
          <p class="eyebrow">{plugin.release.version}</p>
          <h2 class="balance mt-3 whitespace-pre-line text-3xl font-semibold sm:text-4xl">{c.previewTitle}</h2>
          <p class="mt-5 text-base leading-8 text-muted sm:text-lg">{c.previewDescription}</p>
        </div>
      </div>
    </section>

    <section class="container-page pb-16" aria-labelledby="gallery-title">
      <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">{t(locale, "home.preview.galleryEyebrow")}</p>
          <h2 id="gallery-title" class="mt-2 text-3xl font-semibold sm:text-4xl">{c.galleryTitle}</h2>
        </div>
        <p class="text-xs text-muted">{t(locale, "home.preview.openFullImage")}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {gallery.map((media) => (
          <figure
            class:list={[
              "m-0 flex flex-col justify-between overflow-hidden rounded-[24px] border border-line bg-panel shadow-soft",
              media.width > media.height && "md:col-span-2",
            ]}
          >
            <a
              href={media.src}
              target="_blank"
              rel="noreferrer"
              aria-label={t(locale, "game.openImageAria", { alt: media.locales[locale].alt })}
              class="block bg-paper p-2"
            >
              <img
                src={media.src}
                width={media.width}
                height={media.height}
                alt={media.locales[locale].alt}
                loading="lazy"
                decoding="async"
                class:list={[
                  "mx-auto w-full rounded-2xl bg-paper object-contain",
                  media.width <= media.height ? "max-h-[520px]" : "max-h-[620px]",
                ]}
              />
            </a>
            <figcaption class="border-t border-line px-5 py-4 text-sm leading-6 text-muted">
              {media.locales[locale].caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="installation" class="container-page section-space scroll-mt-20">
      <div class="rounded-[28px] border border-line bg-panel p-7 shadow-soft md:p-10">
        <p class="eyebrow">
          {plugin.release.host} · {plugin.release.platform}
        </p>
        <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{c.installTitle}</h2>
        <p class="mt-4 max-w-3xl leading-8 text-muted">{c.installNote}</p>
        <ol class="mt-8 grid gap-5 md:grid-cols-3">
          {c.steps.map((step, idx) => (
            <li class="list-none rounded-[22px] border border-line bg-paper/65 p-5">
              <span class="text-xs font-bold tracking-widest text-accent">STEP 0{idx + 1}</span>
              <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2.5 text-sm leading-7 text-muted">
                {step.description.replaceAll("{packageFile}", packageFile)}
              </p>
            </li>
          ))}
        </ol>
        <div class="mt-8 flex flex-wrap gap-3">
          <CTAButton href={plugin.documentation} label={c.source} variant="secondary" external />
        </div>
      </div>
    </section>

    <section class="container-page pb-16 max-w-4xl" aria-labelledby="faq-title">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="mt-3 mb-8 text-3xl font-semibold sm:text-4xl">{c.faqTitle}</h2>
      <div class="faq-accordion">
        {c.faq.map((item) => (
          <details>
            <summary>{item.title}</summary>
            <p class="mt-3 leading-8 text-muted">{item.description}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container-page pb-10">
      <div class="rounded-[28px] border border-line bg-panel p-7 shadow-sm md:p-10">
        <h2 class="text-2xl font-semibold">{c.sourcesTitle}</h2>
        <p class="mt-3 max-w-3xl leading-7 text-muted">{c.sourcesNote}</p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-accent">
          <a href={plugin.repository} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-ink">
            GitHub / Nidofy / dsh_plugin ↗
          </a>
          <a href={plugin.documentation} target="_blank" rel="noreferrer" class="underline underline-offset-4 hover:text-ink">
            AI Village README ↗
          </a>
          <a
            href={`${plugin.repository}/blob/main/THIRD_PARTY_NOTICES.md`}
            target="_blank"
            rel="noreferrer"
            class="underline underline-offset-4 hover:text-ink"
          >
            Third-party notices ↗
          </a>
        </div>
        <p class="mt-5 border-t border-line pt-5 text-sm leading-6 text-muted">{c.license}</p>
        <p class="mt-2 text-xs text-muted">
          {plugin.release.version} · <time datetime={plugin.release.verifiedAt}>{plugin.release.verifiedAt}</time>
        </p>
      </div>
    </section>
  </article>

  <PortfolioNav locale={locale} activeSlug={plugin.slug} />
</BaseLayout>
