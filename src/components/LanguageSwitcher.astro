---
import type { Locale } from "@/data/site";
import { getLocalizedPath } from "@/i18n/routing";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = Astro.url.pathname;
const zhHref = getLocalizedPath("zh-CN", path);
const enHref = getLocalizedPath("en", path);
---

<nav
  aria-label={t(locale, "language.aria")}
  data-language-switcher
  class="flex shrink-0 items-center rounded-full border border-line bg-white/78 p-1 text-sm shadow-sm backdrop-blur"
>
  <a
    class:list={[
      "rounded-full px-3 py-1.5 font-medium transition",
      locale === "zh-CN" ? "bg-ink text-white" : "text-muted hover:text-ink",
    ]}
    aria-current={locale === "zh-CN" ? "page" : undefined}
    href={zhHref}
  >
    中
  </a>
  <a
    class:list={[
      "rounded-full px-3 py-1.5 font-medium transition",
      locale === "en" ? "bg-ink text-white" : "text-muted hover:text-ink",
    ]}
    aria-current={locale === "en" ? "page" : undefined}
    href={enHref}
  >
    EN
  </a>
</nav>

<script>
  document.querySelectorAll("[data-language-switcher] a").forEach((anchor) => {
    anchor.addEventListener("click", () => {
      if (!(anchor instanceof HTMLAnchorElement)) return;
      const hash = window.location.hash;
      if (hash && !anchor.href.includes("#")) {
        anchor.href = `${anchor.getAttribute("href") ?? ""}${hash}`;
      }
    });
  });
</script>
