---
import CTAButton from "@/components/CTAButton.astro";
import type { PluginEntry } from "@/types/plugin";
import type { Locale } from "@/i18n/locales";

interface Props {
  locale: Locale;
  plugin: PluginEntry;
}

const { locale, plugin } = Astro.props;
const c = plugin.copy[locale];
const media = plugin.media.find((item) => item.role === "hero")!;
---

<article
  id={`project-${plugin.slug}`}
  style="--color-accent: 124 90 56;"
  class="grid scroll-mt-28 gap-8 rounded-[28px] border border-line bg-panel p-6 shadow-soft md:grid-cols-[1.16fr_0.84fr] md:items-center md:p-8 lg:grid-cols-[1.22fr_0.78fr] lg:p-10"
>
  <figure class="m-0 overflow-hidden rounded-[22px] border border-line bg-paper">
    <img src={media.src} width={media.width} height={media.height} alt={media.locales[locale].alt} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
    <figcaption class="border-t border-line bg-white/80 px-4 py-2.5 text-xs leading-5 text-muted">
      {media.locales[locale].caption}
    </figcaption>
  </figure>
  <div class="flex flex-col justify-center">
    <p class="eyebrow">{c.eyebrow}</p>
    <p class="mt-2 text-xs font-medium text-muted">{c.status} · {plugin.release.version}</p>
    <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{c.name}</h2>
    <p class="mt-4 text-base leading-8 text-muted sm:text-lg">{c.summary}</p>
    <div class="mt-7 flex flex-wrap gap-3">
      <CTAButton href={`/${locale}/plugins/${plugin.slug}`} label={c.explore} compact />
      <CTAButton href={plugin.repository} label={c.source} variant="secondary" compact external />
    </div>
  </div>
</article>
