---
import { site, type Locale } from "@/data/site";
import { socialLinks } from "@/data/social";
import { getLocalizedPath } from "@/i18n/routing";
import { t } from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-line bg-white/76">
  <div class="container-page grid gap-8 py-10 md:grid-cols-[1.2fr_0.8fr]">
    <div>
      <p class="font-semibold">{site.name[locale]}</p>
      <p class="mt-3 max-w-xl text-sm leading-6 text-muted">{t(locale, "footer.description")}</p>
    </div>
    <div class="flex flex-wrap items-start gap-x-5 gap-y-3 text-sm text-muted md:justify-end">
      {
        socialLinks.map((item) => (
          <a
            class="transition hover:text-ink"
            href={item.href}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="transition hover:text-ink" href={getLocalizedPath(locale, "privacy")}>{t(locale, "footer.privacy")}</a>
      <a class="transition hover:text-ink" href={getLocalizedPath(locale, "terms")}>{t(locale, "footer.terms")}</a>
    </div>
  </div>
</footer>
