---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getHomepageOgImage } from "@/data/media";
import { site, type Locale } from "@/data/site";
import { getLocalizedPath } from "@/i18n/routing";
import "@/styles/global.css";

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  showHeader?: boolean;
  jsonLd?: Record<string, unknown>;
  alternatePaths?: Partial<Record<Locale, string>>;
  ogImage?: string;
  accentRgb?: string;
}

const {
  locale = "zh-CN",
  title,
  description,
  showHeader = true,
  jsonLd,
  alternatePaths = {},
  ogImage,
  accentRgb,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, site.baseUrl).toString();
const zhPath = alternatePaths["zh-CN"] ?? (currentPath === "/" ? "/" : getLocalizedPath("zh-CN", currentPath));
const enPath = alternatePaths.en ?? (currentPath === "/" ? "/" : getLocalizedPath("en", currentPath));
const resolvedOg = ogImage ?? getHomepageOgImage(locale);
const absoluteOgImage = resolvedOg ? new URL(resolvedOg, site.baseUrl).toString() : undefined;
const bodyStyle = accentRgb ? `--color-accent: ${accentRgb};` : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, site.baseUrl).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, site.baseUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(zhPath, site.baseUrl).toString()} />
    <meta property="og:site_name" content={site.name[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body style={bodyStyle}>
    {showHeader && <Header locale={locale} />}
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
